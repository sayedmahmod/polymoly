{
  "name": "polymoly",
  "displayName": "PolyMoly",
  "description": "%description%",
  "version": "0.1.11",
  "publisher": "Sayed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sayedmahmod/polymoly.git"
  },
  "homepage": "https://github.com/sayedmahmod/polymoly#readme",
  "bugs": {
    "url": "https://github.com/sayedmahmod/polymoly/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "chat",
    "claude code",
    "codex",
    "minimax",
    "mcp",
    "llm",
    "multi-provider"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "polyagent",
          "title": "PolyMoly",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "polyagent": [
        {
          "type": "webview",
          "id": "polyagent.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "polyagent.newChat",
        "title": "%cmd.newChat%",
        "icon": "$(add)"
      },
      {
        "command": "polyagent.openUsage",
        "title": "%cmd.openUsage%"
      },
      {
        "command": "polyagent.setApiKey",
        "title": "%cmd.setApiKey%"
      },
      {
        "command": "polyagent.setAdminKey",
        "title": "%cmd.setAdminKey%"
      },
      {
        "command": "polyagent.clearKeys",
        "title": "%cmd.clearKeys%"
      },
      {
        "command": "polyagent.editProviders",
        "title": "%cmd.editProviders%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "polyagent.newChat",
          "when": "view == polyagent.chat",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "PolyMoly",
      "properties": {
        "polyagent.language": {
          "type": "string",
          "enum": [
            "auto",
            "de",
            "en",
            "es",
            "fr",
            "ar",
            "zh"
          ],
          "enumItemLabels": [
            "Auto",
            "Deutsch",
            "English",
            "Español",
            "Français",
            "العربية",
            "简体中文"
          ],
          "markdownEnumDescriptions": [
            "%cfg.languageAuto%",
            "",
            "",
            "",
            "",
            "",
            ""
          ],
          "default": "auto",
          "markdownDescription": "%cfg.language%"
        },
        "polyagent.providers": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object"
          },
          "markdownDescription": "%cfg.providers%"
        },
        "polyagent.mcpServers": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object"
          },
          "markdownDescription": "%cfg.mcpServers%"
        },
        "polyagent.skills.directory": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.skillsDir%"
        },
        "polyagent.skills.disabled": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "%cfg.skillsDisabled%"
        },
        "polyagent.defaultProvider": {
          "type": "string",
          "default": "claude",
          "markdownDescription": "%cfg.defaultProvider%"
        },
        "polyagent.fallbackOrder": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "%cfg.fallbackOrder%"
        },
        "polyagent.claude.permissionMode": {
          "type": "string",
          "enum": [
            "plan",
            "manual",
            "dontAsk",
            "acceptEdits",
            "auto",
            "bypassPermissions"
          ],
          "default": "acceptEdits",
          "markdownDescription": "%cfg.claudePermission%"
        },
        "polyagent.codex.sandbox": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "default": "workspace-write",
          "markdownDescription": "%cfg.codexSandbox%"
        },
        "polyagent.http.permissionMode": {
          "type": "string",
          "enum": [
            "readonly",
            "edit",
            "write",
            "auto"
          ],
          "enumItemLabels": [
            "%cfg.httpPermReadonly%",
            "%cfg.httpPermEdit%",
            "%cfg.httpPermWrite%",
            "%cfg.httpPermAuto%"
          ],
          "default": "write",
          "markdownDescription": "%cfg.httpPermission%"
        },
        "polyagent.plan.maxParallelTasks": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "markdownDescription": "%cfg.planParallel%"
        },
        "polyagent.context.tokenBudget": {
          "type": "number",
          "default": 1400,
          "minimum": 400,
          "maximum": 8000,
          "markdownDescription": "%cfg.contextBudget%"
        },
        "polyagent.usage.days": {
          "type": "number",
          "default": 30,
          "markdownDescription": "%cfg.usageDays%"
        },
        "polyagent.usage.autoRefreshMinutes": {
          "type": "number",
          "default": 0,
          "markdownDescription": "%cfg.usageRefresh%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
